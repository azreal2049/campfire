{
  "name": "campfire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "autosync": "node scripts/autosync.mjs",
    "autosync:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autosync.ps1",
    "autosync:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autosync.ps1",
    "discord-updates:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discord-updates.ps1 -Mode Setup",
    "discord-updates": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discord-updates.ps1 -Mode Send",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
